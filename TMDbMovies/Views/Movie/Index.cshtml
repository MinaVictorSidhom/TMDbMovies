@model TMDbMovies.Models.MovieResult

@{
    ViewData["Title"] = "Movie Search";
}

<div class="container mt-4">
    <h1>Movie Search</h1>

    <form asp-action="Search" asp-controller="Movie" method="post" class="mb-4">
        <div class="input-group">
            <input type="text" name="title" class="form-control"
                   placeholder="Enter movie title" required />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">
            @ViewBag.Error
        </div>
    }

    @if (Model != null)
    {
        <div class="card" style="max-width: 500px;">
            <div class="row g-0">
                <div class="col-md-4">
                    @if (!string.IsNullOrEmpty(Model.FullPosterUrl))
                    {
                        <img src="@Model.FullPosterUrl" class="img-fluid rounded-start" alt="@Model.Title" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-secondary text-white h-100">
                            No Image
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <div class="card-body">
                        <h5 class="card-title">
                            @Model.Title
                            @if (!string.IsNullOrEmpty(Model.ReleaseDate) && Model.ReleaseDate.Length >= 4)
                            {
                                <span>(@Model.ReleaseDate.Substring(0, 4))</span>
                            }
                        </h5>
                        <p class="card-text">
                            <strong>Rating:</strong> @Model.VoteAverage / 10
                        </p>
                        <p class="card-text">@Model.Overview</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>