@model TMDbMovies.Models.MovieResult

@{
    ViewData["Title"] = "Movie Search";
}

<div class="movie-search-page">
    <div class="container">
        <div class="search-header">
            <h1>🎬 Movie Search</h1>
            <p>Find any movie by title, powered by TMDb</p>
        </div>

        <form asp-action="Search" asp-controller="Movie" method="post" class="search-form">
            <div class="input-group">
                <input type="text" name="title" class="form-control"
                       placeholder="Enter movie title..." required />
                <button type="submit" class="btn">Search</button>
            </div>
        </form>

        @if (ViewBag.Error != null)
        {
            <div class="alert-custom">
                ⚠️ @ViewBag.Error
            </div>
        }

        @if (Model != null)
        {
            <div class="movie-card">
                <div class="row g-0">
                    <div class="col-md-4 movie-poster-col">
                        @if (!string.IsNullOrEmpty(Model.FullPosterUrl))
                        {
                            <img src="@Model.FullPosterUrl" alt="@Model.Title" />
                        }
                        else
                        {
                            <div class="no-image-placeholder">No Image Available</div>
                        }
                    </div>
                    <div class="col-md-8">
                        <div class="movie-body">
                            <h5 class="movie-title">
                                @Model.Title
                                @if (!string.IsNullOrEmpty(Model.ReleaseDate) && Model.ReleaseDate.Length >= 4)
                                {
                                    <span class="movie-year">(@Model.ReleaseDate.Substring(0, 4))</span>
                                }
                            </h5>
                            <div class="rating-badge">
                                @Model.VoteAverage.ToString("0.0") / 10
                            </div>
                            <p class="movie-overview">@Model.Overview</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>